// Prisma schema for the Guidde alternative.
// Steps (with screenshots + annotations) are stored as a single JSON blob per
// guide — they're always read/written as a unit, so a nested document is simpler
// and faster than fully-normalized rows for this MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  guides       Guide[]
  tokens       ApiToken[]
  ttsSetting   TtsSetting?
  brandKit     BrandKit?
  memberships  Membership[]
  sentInvites  Invite[]     @relation("InvitedBy")
}

// A team space that owns guides and has members. Every user gets a personal
// workspace on signup; additional shared workspaces enable collaboration.
model Workspace {
  id          String       @id @default(cuid())
  name        String
  personal    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  memberships Membership[]
  invites     Invite[]
  guides      Guide[]
}

// A user's role in a workspace. Roles are ordered viewer < editor < admin < owner
// (see lib/workspace.ts). A user has exactly one membership per workspace.
model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("editor")
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

// A pending invitation to join a workspace, redeemable via a one-time token.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("editor")
  token       String    @unique
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@index([workspaceId])
  @@index([email])
}

// Per-tenant branding applied to guide cover slides and exports.
model BrandKit {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  logo        String? // data URL
  accentColor String   @default("#6366f1")
  updatedAt   DateTime @updatedAt
}

// Per-tenant "bring your own key" TTS config. The API key is encrypted at rest
// (see lib/crypto.ts) and never returned to the client.
model TtsSetting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String // "openai" | "elevenlabs"
  apiKeyEnc String
  voice     String?
  model     String?
  updatedAt DateTime @updatedAt
}

// Personal access tokens used by the Chrome extension to POST captures.
// Only the sha256 hash is stored; the plaintext is shown once at creation.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Guide {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  showCover  Boolean  @default(true)
  showOutro  Boolean  @default(true)
  ctaText    String?
  ctaUrl     String?
  musicUrl   String?
  publicSlug String   @unique
  isPublic   Boolean  @default(false)
  // JSON-serialized Step[] (screenshots, click points, annotations, blur regions)
  steps      String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The owning workspace. Nullable for legacy rows; lazily backfilled to the
  // creator's personal workspace on first access (see lib/workspace.ts).
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  events     GuideEvent[]
  jobs       Job[]

  @@index([updatedAt])
  @@index([userId])
  @@index([workspaceId])
}

// Background job for slow work (currently MP4 rendering) so requests don't block.
// A DB-backed queue drained by an in-process worker (see lib/jobs/*).
model Job {
  id        String   @id @default(cuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  type      String // "video"
  status    String   @default("queued") // queued | running | done | error
  progress  Int      @default(0) // 0..100
  result    String? // e.g. media URL when done
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([guideId])
}

// Lightweight viewer analytics for shared guides.
model GuideEvent {
  id        String   @id @default(cuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  type      String // "view" | "complete"
  source    String // "public" | "embed"
  createdAt DateTime @default(now())

  @@index([guideId, createdAt])
}
