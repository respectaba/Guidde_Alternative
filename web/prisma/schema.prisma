// Prisma schema for the Guidde alternative.
// Steps (with screenshots + annotations) are stored as a single JSON blob per
// guide — they're always read/written as a unit, so a nested document is simpler
// and faster than fully-normalized rows for this MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  guides       Guide[]
  tokens       ApiToken[]
  ttsSetting   TtsSetting?
}

// Per-tenant "bring your own key" TTS config. The API key is encrypted at rest
// (see lib/crypto.ts) and never returned to the client.
model TtsSetting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String // "openai" | "elevenlabs"
  apiKeyEnc String
  voice     String?
  model     String?
  updatedAt DateTime @updatedAt
}

// Personal access tokens used by the Chrome extension to POST captures.
// Only the sha256 hash is stored; the plaintext is shown once at creation.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Guide {
  id         String   @id @default(cuid())
  title      String
  publicSlug String   @unique
  isPublic   Boolean  @default(false)
  // JSON-serialized Step[] (screenshots, click points, annotations, blur regions)
  steps      String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([updatedAt])
  @@index([userId])
}
