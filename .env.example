# ---- Web app (web/.env) ----

# SQLite database file (relative to web/prisma)
DATABASE_URL="file:./dev.db"

# Base URL the app is served from (used for share links & extension handoff)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign session cookies. Set a long random value in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- AI: captions ----
# "browser" = heuristic captions generated client-side (no key, default)
# "claude"  = richer captions via the Anthropic API (server-side)
AI_PROVIDER="browser"
ANTHROPIC_API_KEY=""

# ---- AI: text-to-speech (voiceover) ----
# "browser"    = Web Speech API in the client (no key, default)
# "espeak"     = offline server-side TTS via the espeak-ng binary (no key)
# "openai"     = OpenAI audio/speech (neural)      [needs TTS_API_KEY]
# "elevenlabs" = ElevenLabs TTS (neural)           [needs TTS_API_KEY]
TTS_PROVIDER="browser"
TTS_API_KEY=""
# Optional overrides for the neural providers:
# TTS_MODEL="gpt-4o-mini-tts"
# TTS_VOICE="alloy"
